{
  "REFUND_POLICY": {
    "workflow": "REFUND_POLICY",
    "description": "Determine the refund policy applicable to a customer's order (timelines, method, fees).",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "load_policy",
        "workflow": "REFUND_POLICY_LOOKUP",
        "input": {
          "order": "$resolve_order.order"
        },
        "output": {
          "policy": "$result.policy"
        }
      }
    ],
    "output": {
      "policy": "$load_policy.policy"
    }
  },
  "REFUND_STATUS": {
    "workflow": "REFUND_STATUS",
    "description": "Fetch the current status of a refund associated with an order or return.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "return_reference": "optional"
    },
    "steps": [
      {
        "id": "fetch_refund",
        "tool": "shopify.get_refund",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference",
          "return_reference": "$input.return_reference"
        }
      }
    ],
    "output": {
      "refund_id": "$fetch_refund.refund.id",
      "status": "$fetch_refund.refund.status"
    }
  },
  "REFUND_DETAILS": {
    "workflow": "REFUND_DETAILS",
    "description": "Fetch full details of a refund (line items refunded, method, timestamps, transaction id).",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "return_reference": "optional"
    },
    "steps": [
      {
        "id": "fetch_refund",
        "tool": "shopify.get_refund",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference",
          "return_reference": "$input.return_reference"
        }
      }
    ],
    "output": {
      "refund": "$fetch_refund.refund"
    }
  },
  "REFUND_AMOUNT": {
    "workflow": "REFUND_AMOUNT",
    "description": "Calculate or fetch the refund amount owed for an order, return, or specific line items.",
    "input": {
      "customer_id": "required",
      "order_reference": "required",
      "line_items": "optional"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "calculate",
        "tool": "shopify.calculate_refund_amount",
        "input": {
          "order": "$resolve_order.order",
          "line_items": "$input.line_items"
        }
      }
    ],
    "output": {
      "amount": "$calculate.amount",
      "currency": "$calculate.currency",
      "breakdown": "$calculate.breakdown"
    }
  },
  "CANCELLATION_POLICY": {
    "workflow": "CANCELLATION_POLICY",
    "description": "Determine the cancellation policy applicable to a customer's order.",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "load_policy",
        "workflow": "CANCELLATION_POLICY_LOOKUP",
        "input": {
          "order": "$resolve_order.order"
        },
        "output": {
          "policy": "$result.policy"
        }
      }
    ],
    "output": {
      "policy": "$load_policy.policy"
    }
  },
  "CANCELLATION_ELIGIBILITY": {
    "workflow": "CANCELLATION_ELIGIBILITY",
    "description": "Check whether an order is still eligible for cancellation based on its fulfillment/payment state.",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "load_policy",
        "workflow": "CANCELLATION_POLICY_LOOKUP",
        "input": {
          "order": "$resolve_order.order"
        },
        "output": {
          "policy": "$result.policy"
        }
      },
      {
        "id": "evaluate",
        "rule": "cancellation_eligibility_ruleset",
        "input": {
          "order": "$resolve_order.order",
          "policy": "$load_policy.policy"
        }
      }
    ],
    "output": {
      "eligible": "$evaluate.eligible",
      "reason": "$evaluate.reason"
    }
  },
  "CANCEL_ORDER": {
    "workflow": "CANCEL_ORDER",
    "description": "Cancel an order after confirming eligibility, optionally triggering a refund.",
    "input": {
      "customer_id": "required",
      "order_reference": "required",
      "cancel_reason": "required",
      "refund": "optional"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order_id": "$result.order_id",
          "order": "$result.order"
        }
      },
      {
        "id": "check_eligibility",
        "workflow": "CANCELLATION_ELIGIBILITY",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "eligible": "$result.eligible"
        }
      },
      {
        "id": "cancel",
        "tool": "shopify.order_cancel",
        "input": {
          "order_id": "$resolve_order.order_id",
          "reason": "$input.cancel_reason",
          "refund": "$input.refund"
        },
        "condition": "$check_eligibility.eligible == true"
      }
    ],
    "output": {
      "order_id": "$resolve_order.order_id",
      "cancelled": "$cancel.cancelled",
      "eligible": "$check_eligibility.eligible"
    }
  },
  "CANCELLATION_STATUS": {
    "workflow": "CANCELLATION_STATUS",
    "description": "Fetch the current cancellation status of an order.",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      }
    ],
    "output": {
      "cancelled_at": "$resolve_order.order.cancelled_at",
      "cancel_reason": "$resolve_order.order.cancel_reason"
    }
  }
}