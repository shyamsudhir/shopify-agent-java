{
  "conventions": {
    "how_to_read": "For each sub_intent, check its workflows top-to-bottom and run the FIRST one whose trigger_entity (and secondary_entity, if listed) is actually present. Only one workflow fires per turn.",
    "step_source_legend": {
      "fetch_manifest": "fetch_order, fetch_order_by_name, fetch_order_by_confirmation_number, fetch_order_by_checkout_token, fetch_order_by_tracking, fetch_order_by_tracking_url, fetch_order_by_transaction, fetch_orders_by_discount_code, fetch_orders_by_po_number, fetch_orders_in_duration, fetch_orders_by_customer, fetch_orders_by_email, fetch_orders_by_phone, fetch_orders_by_sku, fetch_draft_orders, fetch_latest_orders, search_orders — the 40-method order-fetch manifest.",
      "action_or_check_tool": "verify_order_ownership, check_return_eligibility, check_cancellation_eligibility, get_return_status, estimate_refund_amount, create_draft_order, send_draft_order_invoice, convert_draft_to_order, initiate_return, issue_refund, initiate_exchange, cancel_order, update_shipping_address, reschedule_delivery, report_delivery_issue — from your 24-tool sub-intent list, not the fetch manifest."
    },
    "ownership_proof_rule": "CORRECTED: ownership verification now gates DISCLOSURE, not just mutation. Any workflow that resolves an order via a guessable/observable identifier (orderId, orderName, trackingNumber, trackingUrl, sku, discountCode, poNumber, dateRange) inserts verify_order_ownership right after the fetch and BEFORE the result is used for anything — reading it back to the customer, checking eligibility, or acting on it — and requires a secondary_entity (email or phone) to check against. If no secondary entity was captured, the workflow cannot proceed to disclosure; ask for one first. Identifiers that only the real owner would ever know or possess (confirmationNumber, checkoutToken, transactionId) are treated as self-verifying and skip the extra step. customerId/email/phone used as the PRIMARY resolver (e.g. fetch_orders_by_email) are exempt too, since knowledge of the correct value is itself the access check for that lookup."
  },
  "get_order": {
    "workflows": [
      { "trigger_entity": "orderId", "secondary_entity": "email", "sequence": ["fetch_order", "verify_order_ownership"] },
      { "trigger_entity": "orderId", "secondary_entity": "phone", "sequence": ["fetch_order", "verify_order_ownership"] },
      { "trigger_entity": "orderName", "secondary_entity": "email, phone", "sequence": ["fetch_order_by_name", "verify_order_ownership"] },
      { "trigger_entity": "confirmationNumber", "sequence": ["fetch_order_by_confirmation_number"], "note": "Self-verifying — possession of the code is proof." },
      { "trigger_entity": "checkoutToken", "sequence": ["fetch_order_by_checkout_token"], "note": "Self-verifying." },
      { "trigger_entity": "transactionId", "sequence": ["fetch_order_by_transaction"], "note": "Payment-linked, treated as self-verifying." },
      { "trigger_entity": "trackingNumber", "secondary_entity": "email or phone", "sequence": ["fetch_order_by_tracking", "verify_order_ownership"] },
      { "trigger_entity": "trackingUrl", "secondary_entity": "email or phone", "sequence": ["fetch_order_by_tracking_url", "verify_order_ownership"] },
      { "trigger_entity": "discountCode", "secondary_entity": "email or phone", "sequence": ["fetch_orders_by_discount_code", "verify_order_ownership"], "note": "Can return multiple orders — disambiguate to one, then verify against that one." },
      { "trigger_entity": "poNumber", "secondary_entity": "email or phone", "sequence": ["fetch_orders_by_po_number", "verify_order_ownership"], "note": "B2B — a company-account session identity may substitute for the secondary entity if you have one." },
      { "trigger_entity": "last",  "sequence": ["fetch_last_order"], "note": "Only valid if customerId can be passed silently from an authenticated session." },
      { "trigger_entity": "credit_card_last4",  "sequence": ["FETCH_ORDER_BY_QUERY"], "note": "Only valid if customerId can be passed silently from an authenticated session." },
      { "trigger_entity": "delivery_method",  "sequence": ["FETCH_ORDER_BY_QUERY"], "note": "Only valid if customerId can be passed silently from an authenticated session." },
      { "trigger_entity": "payment_id",  "sequence": ["FETCH_ORDER_BY_QUERY"], "note": "Only valid if customerId can be passed silently from an authenticated session." },
      { "trigger_entity": "return_status",  "sequence": ["FETCH_ORDER_BY_QUERY"], "note": "Only valid if customerId can be passed silently from an authenticated session." }
    ]
  },
