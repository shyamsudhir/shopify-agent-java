{
  "PRODUCT_SEARCH": {
    "workflow": "PRODUCT_SEARCH",
    "description": "Search the store catalog for products matching a text query and/or filters.",
    "input": {
      "query": "required",
      "filters": "optional",
      "limit": "optional"
    },
    "steps": [
      {
        "id": "search",
        "tool": "shopify.search_products",
        "input": {
          "query": "$input.query",
          "filters": "$input.filters",
          "limit": "$input.limit"
        }
      }
    ],
    "output": {
      "products": "$search.products",
      "count": "$search.count"
    }
  },
  "PRODUCT_DETAILS": {
    "workflow": "PRODUCT_DETAILS",
    "description": "Fetch full details for a specific product (description, images, price, variants).",
    "input": {
      "product_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        }
      }
    ],
    "output": {
      "product": "$resolve_product.product"
    }
  },
  "PRODUCT_AVAILABILITY": {
    "workflow": "PRODUCT_AVAILABILITY",
    "description": "Check current stock/inventory availability for a product or variant.",
    "input": {
      "product_reference": "required",
      "location": "optional"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        }
      },
      {
        "id": "check_inventory",
        "tool": "shopify.get_inventory_level",
        "input": {
          "product": "$resolve_product.product",
          "location": "$input.location"
        }
      }
    ],
    "output": {
      "in_stock": "$check_inventory.in_stock",
      "quantity_available": "$check_inventory.quantity_available"
    }
  },
  "PRODUCT_PRICE": {
    "workflow": "PRODUCT_PRICE",
    "description": "Fetch current price (and any active discounts) for a product or variant.",
    "input": {
      "product_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        }
      },
      {
        "id": "fetch_price",
        "tool": "shopify.get_product_price",
        "input": {
          "product": "$resolve_product.product"
        }
      }
    ],
    "output": {
      "price": "$fetch_price.price",
      "compare_at_price": "$fetch_price.compare_at_price",
      "currency": "$fetch_price.currency"
    }
  },
  "PRODUCT_VARIANTS": {
    "workflow": "PRODUCT_VARIANTS",
    "description": "Fetch the list of variants (size, color, etc.) available for a product.",
    "input": {
      "product_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        }
      },
      {
        "id": "fetch_variants",
        "tool": "shopify.list_product_variants",
        "input": {
          "product": "$resolve_product.product"
        }
      }
    ],
    "output": {
      "variants": "$fetch_variants.variants"
    }
  },
  "PRODUCT_OPTIONS": {
    "workflow": "PRODUCT_OPTIONS",
    "description": "Fetch the configurable options (e.g. Size, Color) and their possible values for a product.",
    "input": {
      "product_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        }
      },
      {
        "id": "fetch_options",
        "tool": "shopify.get_product_options",
        "input": {
          "product": "$resolve_product.product"
        }
      }
    ],
    "output": {
      "options": "$fetch_options.options"
    }
  },
  "PRODUCT_RECOMMENDATION": {
    "workflow": "PRODUCT_RECOMMENDATION",
    "description": "Recommend related or complementary products based on a product, order history, or stated preferences.",
    "input": {
      "customer_id": "optional",
      "product_reference": "optional",
      "preferences": "optional",
      "limit": "optional"
    },
    "steps": [
      {
        "id": "resolve_product",
        "workflow": "PRODUCT_RESOLUTION",
        "input": {
          "product_reference": "$input.product_reference"
        },
        "output": {
          "product": "$result.product"
        },
        "condition": "$input.product_reference != null"
      },
      {
        "id": "recommend",
        "tool": "shopify.recommend_products",
        "input": {
          "customer_id": "$input.customer_id",
          "product": "$resolve_product.product",
          "preferences": "$input.preferences",
          "limit": "$input.limit"
        }
      }
    ],
    "output": {
      "recommendations": "$recommend.products"
    }
  }
}