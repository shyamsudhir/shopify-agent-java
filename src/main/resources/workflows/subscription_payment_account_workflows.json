{
  "SUBSCRIPTION_DETAILS": {
    "workflow": "SUBSCRIPTION_DETAILS",
    "description": "Fetch full details of a customer's subscription (plan, items, billing cycle, next order date).",
    "input": {
      "customer_id": "required",
      "subscription_reference": "optional"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer_id": "$result.customer_id"
        }
      },
      {
        "id": "fetch_subscription",
        "tool": "shopify.get_subscription",
        "input": {
          "customer_id": "$resolve_customer.customer_id",
          "subscription_reference": "$input.subscription_reference"
        }
      }
    ],
    "output": {
      "subscription": "$fetch_subscription.subscription"
    }
  },
  "SUBSCRIPTION_STATUS": {
    "workflow": "SUBSCRIPTION_STATUS",
    "description": "Fetch the current status (active, paused, cancelled) of a subscription.",
    "input": {
      "customer_id": "required",
      "subscription_reference": "optional"
    },
    "steps": [
      {
        "id": "fetch_subscription",
        "tool": "shopify.get_subscription",
        "input": {
          "customer_id": "$input.customer_id",
          "subscription_reference": "$input.subscription_reference"
        }
      }
    ],
    "output": {
      "status": "$fetch_subscription.subscription.status"
    }
  },
  "SUBSCRIPTION_CANCEL": {
    "workflow": "SUBSCRIPTION_CANCEL",
    "description": "Cancel an active subscription for a customer.",
    "input": {
      "customer_id": "required",
      "subscription_reference": "required",
      "cancel_reason": "optional"
    },
    "steps": [
      {
        "id": "fetch_subscription",
        "tool": "shopify.get_subscription",
        "input": {
          "customer_id": "$input.customer_id",
          "subscription_reference": "$input.subscription_reference"
        },
        "output": {
          "subscription_id": "$result.subscription.id",
          "status": "$result.subscription.status"
        }
      },
      {
        "id": "cancel",
        "tool": "shopify.subscription_cancel",
        "input": {
          "subscription_id": "$fetch_subscription.subscription_id",
          "reason": "$input.cancel_reason"
        },
        "condition": "$fetch_subscription.status == 'active' or $fetch_subscription.status == 'paused'"
      }
    ],
    "output": {
      "cancelled": "$cancel.cancelled",
      "subscription_id": "$fetch_subscription.subscription_id"
    }
  },
  "SUBSCRIPTION_UPDATE": {
    "workflow": "SUBSCRIPTION_UPDATE",
    "description": "Update a subscription's plan, items, quantity, frequency, or next billing date.",
    "input": {
      "customer_id": "required",
      "subscription_reference": "required",
      "updates": "required"
    },
    "steps": [
      {
        "id": "fetch_subscription",
        "tool": "shopify.get_subscription",
        "input": {
          "customer_id": "$input.customer_id",
          "subscription_reference": "$input.subscription_reference"
        },
        "output": {
          "subscription_id": "$result.subscription.id"
        }
      },
      {
        "id": "update",
        "tool": "shopify.subscription_update",
        "input": {
          "subscription_id": "$fetch_subscription.subscription_id",
          "updates": "$input.updates"
        }
      }
    ],
    "output": {
      "subscription": "$update.subscription"
    }
  },
  "PAYMENT_METHODS": {
    "workflow": "PAYMENT_METHODS",
    "description": "Fetch the payment methods saved on a customer's account, or available at checkout.",
    "input": {
      "customer_id": "optional"
    },
    "steps": [
      {
        "id": "fetch",
        "tool": "shopify.list_payment_methods",
        "input": {
          "customer_id": "$input.customer_id"
        }
      }
    ],
    "output": {
      "methods": "$fetch.methods"
    }
  },
  "PAYMENT_STATUS": {
    "workflow": "PAYMENT_STATUS",
    "description": "Fetch the current payment status of an order (pending, paid, partially refunded, etc.).",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      }
    ],
    "output": {
      "payment_status": "$resolve_order.order.financial_status"
    }
  },
  "PAYMENT_FAILURE": {
    "workflow": "PAYMENT_FAILURE",
    "description": "Diagnose a failed payment attempt on an order or checkout and surface the decline reason.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "checkout_reference": "optional"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        },
        "condition": "$input.order_reference != null"
      },
      {
        "id": "fetch_failure",
        "tool": "shopify.get_payment_failure_reason",
        "input": {
          "order": "$resolve_order.order",
          "checkout_reference": "$input.checkout_reference"
        }
      }
    ],
    "output": {
      "decline_code": "$fetch_failure.decline_code",
      "message": "$fetch_failure.message"
    }
  },
  "PAYMENT_DETAILS": {
    "workflow": "PAYMENT_DETAILS",
    "description": "Fetch detailed payment transaction information for an order (gateway, last4, amounts, timestamps).",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "fetch_transactions",
        "tool": "shopify.list_order_transactions",
        "input": {
          "order": "$resolve_order.order"
        }
      }
    ],
    "output": {
      "transactions": "$fetch_transactions.transactions"
    }
  },
  "ACCOUNT_CREATE": {
    "workflow": "ACCOUNT_CREATE",
    "description": "Create a new customer account.",
    "input": {
      "email": "required",
      "first_name": "optional",
      "last_name": "optional",
      "password": "optional"
    },
    "steps": [
      {
        "id": "create",
        "tool": "shopify.customer_create",
        "input": {
          "email": "$input.email",
          "first_name": "$input.first_name",
          "last_name": "$input.last_name",
          "password": "$input.password"
        }
      }
    ],
    "output": {
      "customer_id": "$create.customer.id",
      "customer": "$create.customer"
    }
  },
  "ACCOUNT_LOGIN": {
    "workflow": "ACCOUNT_LOGIN",
    "description": "Authenticate a customer and issue an access token/session.",
    "input": {
      "email": "required",
      "password": "required"
    },
    "steps": [
      {
        "id": "authenticate",
        "tool": "shopify.customer_login",
        "input": {
          "email": "$input.email",
          "password": "$input.password"
        }
      }
    ],
    "output": {
      "customer_id": "$authenticate.customer_id",
      "access_token": "$authenticate.access_token"
    }
  },
  "ACCOUNT_STATUS": {
    "workflow": "ACCOUNT_STATUS",
    "description": "Fetch a customer account's status (active, disabled, email-verified).",
    "input": {
      "customer_id": "required"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer": "$result.customer"
        }
      }
    ],
    "output": {
      "status": "$resolve_customer.customer.status",
      "email_verified": "$resolve_customer.customer.email_verified"
    }
  },
  "ACCOUNT_UPDATE": {
    "workflow": "ACCOUNT_UPDATE",
    "description": "Update a customer account's profile fields (name, email, phone, marketing preferences).",
    "input": {
      "customer_id": "required",
      "updates": "required"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer_id": "$result.customer_id"
        }
      },
      {
        "id": "update",
        "tool": "shopify.customer_update",
        "input": {
          "customer_id": "$resolve_customer.customer_id",
          "updates": "$input.updates"
        }
      }
    ],
    "output": {
      "customer": "$update.customer"
    }
  },
  "ACCOUNT_PASSWORD_RESET": {
    "workflow": "ACCOUNT_PASSWORD_RESET",
    "description": "Trigger a password reset email for a customer account.",
    "input": {
      "email": "required"
    },
    "steps": [
      {
        "id": "trigger_reset",
        "tool": "shopify.customer_password_reset_request",
        "input": {
          "email": "$input.email"
        }
      }
    ],
    "output": {
      "sent": "$trigger_reset.sent"
    }
  }
}