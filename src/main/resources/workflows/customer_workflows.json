{
  "CUSTOMER_LOOKUP": {
    "workflow": "CUSTOMER_LOOKUP",
    "description": "Look up a customer record by id, email, or phone number.",
    "input": {
      "customer_id": "optional",
      "email": "optional",
      "phone": "optional"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id",
          "email": "$input.email",
          "phone": "$input.phone"
        },
        "output": {
          "customer_id": "$result.customer_id",
          "customer": "$result.customer"
        }
      }
    ],
    "output": {
      "customer_id": "$resolve_customer.customer_id",
      "customer": "$resolve_customer.customer"
    }
  },
  "CUSTOMER_ORDER_HISTORY": {
    "workflow": "CUSTOMER_ORDER_HISTORY",
    "description": "Retrieve a customer's historical order list, optionally filtered by date range or status.",
    "input": {
      "customer_id": "required",
      "date_range": "optional",
      "status_filter": "optional",
      "limit": "optional"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer_id": "$result.customer_id"
        }
      },
      {
        "id": "fetch_history",
        "tool": "shopify.list_orders",
        "input": {
          "customer_id": "$resolve_customer.customer_id",
          "date_range": "$input.date_range",
          "status_filter": "$input.status_filter",
          "limit": "$input.limit"
        }
      }
    ],
    "output": {
      "orders": "$fetch_history.orders",
      "count": "$fetch_history.count"
    }
  },
  "CUSTOMER_PROFILE": {
    "workflow": "CUSTOMER_PROFILE",
    "description": "Fetch a customer's profile details (name, contact info, marketing preferences, loyalty tier).",
    "input": {
      "customer_id": "required"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer": "$result.customer"
        }
      },
      {
        "id": "fetch_profile",
        "tool": "shopify.get_customer_profile",
        "input": {
          "customer_id": "$input.customer_id"
        }
      }
    ],
    "output": {
      "profile": "$fetch_profile.profile"
    }
  },
  "CUSTOMER_ADDRESS": {
    "workflow": "CUSTOMER_ADDRESS",
    "description": "Retrieve a customer's saved address(es), optionally a specific one (e.g. default shipping).",
    "input": {
      "customer_id": "required",
      "address_type": "optional"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer_id": "$result.customer_id"
        }
      },
      {
        "id": "fetch_addresses",
        "tool": "shopify.list_customer_addresses",
        "input": {
          "customer_id": "$resolve_customer.customer_id",
          "address_type": "$input.address_type"
        }
      }
    ],
    "output": {
      "addresses": "$fetch_addresses.addresses",
      "default_address": "$fetch_addresses.default_address"
    }
  }
}