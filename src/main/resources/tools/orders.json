        "operation": "query customer(id) { orders(first, sortKey: PROCESSED_AT, reverse: true) } — or customers(query:\"email:…\") first",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "email",
              "type": "string",
              "description": "Used to resolve the Customer GID via customers(query:\"email:…\")"
            }
          ],
          "optional": [
            {
              "name": "first",
              "type": "int",
              "description": "Number of orders, default 5"
            }
          ]
        }
      }
    },
    {
