{
  "higher_intent": "orders",
  "description": "Core order lifecycle: status, drafting, fulfillment, shipping, tracking, returns, refunds, exchanges, and cancellations.",
  "tool_count": 24,
  "tools": [
    {
      "name": "get_order",
      "category": "6. Orders",
      "sub_intent": "order_status",
      "description": "Look up a single order's status, items, address, totals.",
      "invoke_when": "Customer references an order number or asks 'where is my order'.",
      "input_schema": {
        "type": "object",
        "properties": {
          "order_number": {
            "type": "string",
            "description": "order_number"
          },
          "email": {
            "type": "string",
            "description": "email (for verification)"
          }
        },
        "required": [
          "order_number"
        ]
      },
      "outputs": "Order object (status, items, totals, address)",
      "failure_scenarios": "Order not found; email/order mismatch (auth failure)",
      "read_or_write": "read",
      "human_confirmation_required": false,
      "customer_visible_followup": "Summarizes order status.",
      "related_tools": [
        "track_shipment",
        "get_refund_status"
      ],
      "exposure": "Direct",
      "shopify_api": {
        "source": "Shopify Admin GraphQL API",
        "http_method": "POST",
        "operation": "query orders(first, query: \"name:#1001\") or order(id)",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "query",
              "type": "string",
              "description": "e.g. \"name:#1001\" — Shopify order \"name\" includes the # prefix"
            }
          ],
          "optional": [
            {
              "name": "email (post-fetch filter)",
              "type": "string",
              "description": "Used by the backend to verify the returned order belongs to this customer"
            }
          ]
        }
      }
    },
    {
