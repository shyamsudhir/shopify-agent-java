{
  "DISCOUNT_POLICY": {
    "workflow": "DISCOUNT_POLICY",
    "description": "Retrieve the store's general discount and promotion policy (stacking rules, exclusions).",
    "input": {},
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_discount_policy",
        "input": {}
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "COUPON_VALIDATE": {
    "workflow": "COUPON_VALIDATE",
    "description": "Validate whether a discount code is currently valid and applicable to a cart.",
    "input": {
      "code": "required",
      "cart_id": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id"
        },
        "output": {
          "cart": "$result.cart"
        },
        "condition": "$input.cart_id != null"
      },
      {
        "id": "validate",
        "tool": "shopify.validate_discount_code",
        "input": {
          "code": "$input.code",
          "cart": "$resolve_cart.cart"
        }
      }
    ],
    "output": {
      "valid": "$validate.valid",
      "reason": "$validate.reason",
      "discount": "$validate.discount"
    }
  },
  "COUPON_APPLY": {
    "workflow": "COUPON_APPLY",
    "description": "Apply a validated discount code to a cart.",
    "input": {
      "code": "required",
      "cart_id": "optional",
      "session_token": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart_id": "$result.cart_id"
        }
      },
      {
        "id": "validate",
        "tool": "shopify.validate_discount_code",
        "input": {
          "code": "$input.code"
        },
        "output": {
          "valid": "$result.valid"
        }
      },
      {
        "id": "apply",
        "tool": "shopify.cart_discount_code_apply",
        "input": {
          "cart_id": "$resolve_cart.cart_id",
          "code": "$input.code"
        },
        "condition": "$validate.valid == true"
      }
    ],
    "output": {
      "cart": "$apply.cart",
      "applied": "$validate.valid"
    }
  },
  "PROMOTION_DETAILS": {
    "workflow": "PROMOTION_DETAILS",
    "description": "Fetch details of an active store promotion or campaign.",
    "input": {
      "promotion_reference": "required"
    },
    "steps": [
      {
        "id": "fetch_promotion",
        "tool": "shopify.get_promotion",
        "input": {
          "promotion_reference": "$input.promotion_reference"
        }
      }
    ],
    "output": {
      "promotion": "$fetch_promotion.promotion"
    }
  },
  "STORE_INFORMATION": {
    "workflow": "STORE_INFORMATION",
    "description": "Fetch general store information (name, description, categories, brand info).",
    "input": {},
    "steps": [
      {
        "id": "fetch",
        "tool": "shopify.get_store_info",
        "input": {}
      }
    ],
    "output": {
      "store": "$fetch.store"
    }
  },
  "STORE_POLICIES": {
    "workflow": "STORE_POLICIES",
    "description": "Fetch the full set of store policy documents (returns, shipping, privacy, terms).",
    "input": {
      "policy_type": "optional"
    },
    "steps": [
      {
        "id": "fetch",
        "tool": "shopify.get_store_policies",
        "input": {
          "policy_type": "$input.policy_type"
        }
      }
    ],
    "output": {
      "policies": "$fetch.policies"
    }
  },
  "STORE_HOURS": {
    "workflow": "STORE_HOURS",
    "description": "Fetch store or customer-support operating hours, optionally for a specific location.",
    "input": {
      "location": "optional"
    },
    "steps": [
      {
        "id": "fetch",
        "tool": "shopify.get_store_hours",
        "input": {
          "location": "$input.location"
        }
      }
    ],
    "output": {
      "hours": "$fetch.hours",
      "timezone": "$fetch.timezone"
    }
  },
  "STORE_CONTACT": {
    "workflow": "STORE_CONTACT",
    "description": "Fetch store contact information (support email, phone, social channels).",
    "input": {},
    "steps": [
      {
        "id": "fetch",
        "tool": "shopify.get_store_contact",
        "input": {}
      }
    ],
    "output": {
      "contact": "$fetch.contact"
    }
  }
}