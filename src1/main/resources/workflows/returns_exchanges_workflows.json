      "exchange_reference": "required"
    },
    "steps": [
      {
        "id": "fetch_exchange",
        "tool": "shopify.get_exchange",
        "input": {
          "customer_id": "$input.customer_id",
          "exchange_reference": "$input.exchange_reference"
        }
      }
    ],
    "output": {
      "exchange_id": "$fetch_exchange.exchange.id",
      "status": "$fetch_exchange.exchange.status"
    }
  },
  "EXCHANGE_ITEMS": {
    "workflow": "EXCHANGE_ITEMS",
    "description": "Fetch the original and replacement line items involved in an exchange request.",
    "input": {
      "customer_id": "required",
      "exchange_reference": "required"
    },
    "steps": [
      {
        "id": "fetch_exchange",
        "tool": "shopify.get_exchange",
        "input": {
          "customer_id": "$input.customer_id",
          "exchange_reference": "$input.exchange_reference"
        }
      }
    ],
    "output": {
      "original_items": "$fetch_exchange.exchange.original_items",
      "replacement_items": "$fetch_exchange.exchange.replacement_items"
    }
  }
}