  "EXCHANGE_REQUEST": {
    "workflow": "EXCHANGE_REQUEST",
    "description": "Create a new exchange request: return the original item(s) and issue replacement item(s), after confirming eligibility.",
    "input": {
      "customer_id": "required",
      "order_reference": "required",
      "line_items": "required",
      "replacement_items": "required",
      "reason": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order_id": "$result.order_id",
          "order": "$result.order"
        }
      },
      {
        "id": "check_eligibility",
        "workflow": "EXCHANGE_ELIGIBILITY",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "eligible": "$result.eligible"
        }
      },
      {
        "id": "create_return",
        "tool": "shopify.return_create",
        "input": {
          "order_id": "$resolve_order.order_id",
          "line_items": "$input.line_items",
          "reason": "$input.reason"
        },
        "output": {
          "return_id": "$result.return.id"
        },
        "condition": "$check_eligibility.eligible == true"
      },
      {
        "id": "process_exchange",
        "tool": "shopify.return_process",
        "input": {
          "return_id": "$create_return.return_id",
          "replacement_items": "$input.replacement_items"
        },
        "condition": "$check_eligibility.eligible == true"
      }
    ],
    "output": {
      "exchange_id": "$process_exchange.exchange.id",
      "exchange": "$process_exchange.exchange",
      "eligible": "$check_eligibility.eligible"
    }
  },
  "EXCHANGE_STATUS": {
    "workflow": "EXCHANGE_STATUS",
    "description": "Fetch the current status of an existing exchange request.",
    "input": {
