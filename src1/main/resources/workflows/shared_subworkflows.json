{
  "CUSTOMER_RESOLUTION": {
    "workflow": "CUSTOMER_RESOLUTION",
    "description": "Resolve a customer identifier (id, email, or phone) to a canonical customer record.",
    "input": {
      "customer_id": "optional",
      "email": "optional",
      "phone": "optional"
    },
    "steps": [
      {
        "id": "resolve_reference",
        "type": "resolve",
        "input": {
          "customer_id": "$input.customer_id",
          "email": "$input.email",
          "phone": "$input.phone"
        }
      },
      {
        "id": "fetch",
        "tool": "shopify.get_customer",
        "input": {
          "customer_id": "$resolve_reference.customer_id"
        }
      }
    ],
    "output": {
      "customer_id": "$fetch.customer.id",
      "customer": "$fetch.customer"
    }
  },
  "ORDER_FETCHING": {
    "workflow": "ORDER_FETCHING",
    "description": "Resolve an order reference for a customer and fetch the full order record.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional"
    },
    "steps": [
      {
        "id": "resolve_reference",
        "type": "resolve",
        "input": {
          "reference": "$input.order_reference"
        }
      },
      {
        "id": "fetch",
        "tool": "shopify.get_order",
        "input": {
          "customer_id": "$input.customer_id",
          "order_id": "$resolve_reference.order_id"
        }
      }
    ],
    "output": {
      "order_id": "$fetch.order.id",
      "order": "$fetch.order"
    }
  },
  "PRODUCT_RESOLUTION": {
    "workflow": "PRODUCT_RESOLUTION",
    "description": "Resolve a product reference (from an order line item, SKU, or search text) to a canonical product record.",
    "input": {
      "order": "optional",
      "product_reference": "optional"
    },
    "steps": [
      {
        "id": "resolve_reference",
        "type": "resolve",
        "input": {
          "order": "$input.order",
          "product_reference": "$input.product_reference"
        }
      },
      {
        "id": "fetch",
        "tool": "shopify.get_product",
        "input": {
          "product_id": "$resolve_reference.product_id",
          "variant_id": "$resolve_reference.variant_id"
        }
      }
    ],
    "output": {
      "product_id": "$fetch.product.id",
      "product": "$fetch.product"
    }
  },
  "CART_RESOLUTION": {
    "workflow": "CART_RESOLUTION",
    "description": "Resolve a cart from an existing cart id/session token, creating a new one if none exists.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional"
    },
    "steps": [
      {
        "id": "resolve_reference",
        "type": "resolve",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        }
      },
      {
        "id": "fetch_or_create",
        "tool": "shopify.get_or_create_cart",
        "input": {
          "cart_id": "$resolve_reference.cart_id",
          "session_token": "$input.session_token"
        }
      }
    ],
    "output": {
      "cart_id": "$fetch_or_create.cart.id",
      "cart": "$fetch_or_create.cart"
    }
  },
  "RETURN_POLICY_LOOKUP": {
    "workflow": "RETURN_POLICY_LOOKUP",
    "description": "Load the applicable return policy document(s) for an order and/or product.",
    "input": {
      "order": "optional",
      "product": "optional"
    },
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_return_policy",
        "input": {
          "order": "$input.order",
          "product": "$input.product"
        }
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "RETURN_POLICY_EVALUATION": {
    "workflow": "RETURN_POLICY_EVALUATION",
    "description": "Evaluate a return policy against an order/product to determine eligibility, deadline, and conditions.",
    "input": {
      "order": "required",
      "product": "optional",
      "policy": "required"
    },
    "steps": [
      {
        "id": "evaluate",
        "rule": "return_eligibility_ruleset",
        "input": {
          "order": "$input.order",
          "product": "$input.product",
          "policy": "$input.policy"
        }
      }
    ],
    "output": {
      "eligible": "$evaluate.eligible",
      "deadline": "$evaluate.deadline",
      "conditions": "$evaluate.conditions"
    }
  },
  "EXCHANGE_POLICY_LOOKUP": {
    "workflow": "EXCHANGE_POLICY_LOOKUP",
    "description": "Load the applicable exchange policy document(s) for an order and/or product.",
    "input": {
      "order": "optional",
      "product": "optional"
    },
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_exchange_policy",
        "input": {
          "order": "$input.order",
          "product": "$input.product"
        }
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "EXCHANGE_POLICY_EVALUATION": {
    "workflow": "EXCHANGE_POLICY_EVALUATION",
    "description": "Evaluate an exchange policy against an order/product to determine eligibility, deadline, and conditions.",
    "input": {
      "order": "required",
      "product": "optional",
      "policy": "required"
    },
    "steps": [
      {
        "id": "evaluate",
        "rule": "exchange_eligibility_ruleset",
        "input": {
          "order": "$input.order",
          "product": "$input.product",
          "policy": "$input.policy"
        }
      }
    ],
    "output": {
      "eligible": "$evaluate.eligible",
      "deadline": "$evaluate.deadline",
      "conditions": "$evaluate.conditions"
    }
  },
  "REFUND_POLICY_LOOKUP": {
    "workflow": "REFUND_POLICY_LOOKUP",
    "description": "Load the applicable refund policy for an order (payment method rules, restocking fees, timelines).",
    "input": {
      "order": "required"
    },
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_refund_policy",
        "input": {
          "order": "$input.order"
        }
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "CANCELLATION_POLICY_LOOKUP": {
    "workflow": "CANCELLATION_POLICY_LOOKUP",
    "description": "Load the applicable cancellation policy for an order based on its fulfillment/payment state.",
    "input": {
      "order": "required"
    },
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_cancellation_policy",
        "input": {
          "order": "$input.order"
        }
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "SUPPORT_TICKET_CONTEXT": {
    "workflow": "SUPPORT_TICKET_CONTEXT",
    "description": "Assemble customer, order, and conversation context to attach to a support ticket.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "conversation_summary": "optional"
    },
    "steps": [
      {
        "id": "resolve_customer",
        "workflow": "CUSTOMER_RESOLUTION",
        "input": {
          "customer_id": "$input.customer_id"
        },
        "output": {
          "customer": "$result.customer"
        }
      },
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        },
        "condition": "$input.order_reference != null"
      }
    ],
    "output": {
      "customer": "$resolve_customer.customer",
      "order": "$resolve_order.order",
      "conversation_summary": "$input.conversation_summary"
    }
  }
}