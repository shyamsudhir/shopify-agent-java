{
  "CART_CREATE": {
    "workflow": "CART_CREATE",
    "description": "Create a new cart, optionally pre-populated with initial line items.",
    "input": {
      "customer_id": "optional",
      "initial_items": "optional"
    },
    "steps": [
      {
        "id": "create_cart",
        "tool": "shopify.cart_create",
        "input": {
          "customer_id": "$input.customer_id",
          "initial_items": "$input.initial_items"
        }
      }
    ],
    "output": {
      "cart_id": "$create_cart.cart.id",
      "cart": "$create_cart.cart"
    }
  },
  "CART_VIEW": {
    "workflow": "CART_VIEW",
    "description": "Fetch the current contents of a cart.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart": "$result.cart"
        }
      }
    ],
    "output": {
      "cart": "$resolve_cart.cart"
    }
  },
  "CART_ADD": {
    "workflow": "CART_ADD",
    "description": "Add one or more line items to an existing cart.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional",
      "line_items": "required"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart_id": "$result.cart_id"
        }
      },
      {
        "id": "add_items",
        "tool": "shopify.cart_lines_add",
        "input": {
          "cart_id": "$resolve_cart.cart_id",
          "line_items": "$input.line_items"
        }
      }
    ],
    "output": {
      "cart": "$add_items.cart"
    }
  },
  "CART_REMOVE": {
    "workflow": "CART_REMOVE",
    "description": "Remove one or more line items from an existing cart.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional",
      "line_item_ids": "required"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart_id": "$result.cart_id"
        }
      },
      {
        "id": "remove_items",
        "tool": "shopify.cart_lines_remove",
        "input": {
          "cart_id": "$resolve_cart.cart_id",
          "line_item_ids": "$input.line_item_ids"
        }
      }
    ],
    "output": {
      "cart": "$remove_items.cart"
    }
  },
  "CART_UPDATE": {
    "workflow": "CART_UPDATE",
    "description": "Update quantities or variant selections for existing cart line items.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional",
      "line_item_updates": "required"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart_id": "$result.cart_id"
        }
      },
      {
        "id": "update_items",
        "tool": "shopify.cart_lines_update",
        "input": {
          "cart_id": "$resolve_cart.cart_id",
          "line_item_updates": "$input.line_item_updates"
        }
      }
    ],
    "output": {
      "cart": "$update_items.cart"
    }
  },
  "CHECKOUT": {
    "workflow": "CHECKOUT",
    "description": "Initiate or advance checkout for a cart, returning a checkout URL or completed order.",
    "input": {
      "cart_id": "optional",
      "session_token": "optional",
      "shipping_address": "optional",
      "shipping_method": "optional",
      "payment_method": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id",
          "session_token": "$input.session_token"
        },
        "output": {
          "cart_id": "$result.cart_id",
          "cart": "$result.cart"
        }
      },
      {
        "id": "begin_checkout",
        "tool": "shopify.checkout_create",
        "input": {
          "cart_id": "$resolve_cart.cart_id",
          "shipping_address": "$input.shipping_address",
          "shipping_method": "$input.shipping_method",
          "payment_method": "$input.payment_method"
        }
      }
    ],
    "output": {
      "checkout_id": "$begin_checkout.checkout.id",
      "checkout_url": "$begin_checkout.checkout.url",
      "status": "$begin_checkout.checkout.status"
    }
  },
  "CHECKOUT_STATUS": {
    "workflow": "CHECKOUT_STATUS",
    "description": "Fetch the current status of an in-progress or completed checkout.",
    "input": {
      "checkout_reference": "required"
    },
    "steps": [
      {
        "id": "fetch_checkout",
        "tool": "shopify.get_checkout",
        "input": {
          "checkout_reference": "$input.checkout_reference"
        }
      }
    ],
    "output": {
      "status": "$fetch_checkout.checkout.status",
      "order_id": "$fetch_checkout.checkout.order_id"
    }
  },
  "SHIPPING_POLICY": {
    "workflow": "SHIPPING_POLICY",
    "description": "Retrieve the store's general shipping policy (regions served, carriers, timelines).",
    "input": {},
    "steps": [
      {
        "id": "lookup",
        "tool": "shopify.get_shipping_policy",
        "input": {}
      }
    ],
    "output": {
      "policy": "$lookup.policy"
    }
  },
  "SHIPPING_METHODS": {
    "workflow": "SHIPPING_METHODS",
    "description": "Fetch available shipping methods for a destination and/or cart.",
    "input": {
      "cart_id": "optional",
      "destination_address": "required"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id"
        },
        "output": {
          "cart": "$result.cart"
        },
        "condition": "$input.cart_id != null"
      },
      {
        "id": "fetch_methods",
        "tool": "shopify.list_shipping_methods",
        "input": {
          "cart": "$resolve_cart.cart",
          "destination_address": "$input.destination_address"
        }
      }
    ],
    "output": {
      "methods": "$fetch_methods.methods"
    }
  },
  "SHIPPING_COST": {
    "workflow": "SHIPPING_COST",
    "description": "Calculate the shipping cost for a cart/order given a destination and method.",
    "input": {
      "cart_id": "optional",
      "destination_address": "required",
      "shipping_method": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id"
        },
        "output": {
          "cart": "$result.cart"
        },
        "condition": "$input.cart_id != null"
      },
      {
        "id": "calculate",
        "tool": "shopify.calculate_shipping_cost",
        "input": {
          "cart": "$resolve_cart.cart",
          "destination_address": "$input.destination_address",
          "shipping_method": "$input.shipping_method"
        }
      }
    ],
    "output": {
      "cost": "$calculate.cost",
      "currency": "$calculate.currency"
    }
  },
  "SHIPPING_ESTIMATE": {
    "workflow": "SHIPPING_ESTIMATE",
    "description": "Estimate delivery date range for a cart/order given a destination and method.",
    "input": {
      "cart_id": "optional",
      "destination_address": "required",
      "shipping_method": "optional"
    },
    "steps": [
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id"
        },
        "output": {
          "cart": "$result.cart"
        },
        "condition": "$input.cart_id != null"
      },
      {
        "id": "estimate",
        "tool": "shopify.estimate_delivery_date",
        "input": {
          "cart": "$resolve_cart.cart",
          "destination_address": "$input.destination_address",
          "shipping_method": "$input.shipping_method"
        }
      }
    ],
    "output": {
      "earliest_date": "$estimate.earliest_date",
      "latest_date": "$estimate.latest_date"
    }
  },
  "SHIPPING_ADDRESS": {
    "workflow": "SHIPPING_ADDRESS",
    "description": "Fetch or validate the shipping address on file for an order or cart.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "cart_id": "optional"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        },
        "condition": "$input.order_reference != null"
      },
      {
        "id": "resolve_cart",
        "workflow": "CART_RESOLUTION",
        "input": {
          "cart_id": "$input.cart_id"
        },
        "output": {
          "cart": "$result.cart"
        },
        "condition": "$input.cart_id != null"
      }
    ],
    "output": {
      "address": "$resolve_order.order.shipping_address"
    }
  },
  "TRACK_SHIPMENT": {
    "workflow": "TRACK_SHIPMENT",
    "description": "Fetch live carrier tracking status for a shipment.",
    "input": {
      "customer_id": "required",
      "order_reference": "optional",
      "tracking_number": "optional"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        },
        "condition": "$input.order_reference != null"
      },
      {
        "id": "track",
        "tool": "shopify.track_shipment",
        "input": {
          "order": "$resolve_order.order",
          "tracking_number": "$input.tracking_number"
        }
      }
    ],
    "output": {
      "carrier": "$track.carrier",
      "status": "$track.status",
      "events": "$track.events"
    }
  },
  "DELIVERY_STATUS": {
    "workflow": "DELIVERY_STATUS",
    "description": "Fetch the current delivery status (in transit, out for delivery, delivered) for an order.",
    "input": {
      "customer_id": "required",
      "order_reference": "required"
    },
    "steps": [
      {
        "id": "resolve_order",
        "workflow": "ORDER_FETCHING",
        "input": {
          "customer_id": "$input.customer_id",
          "order_reference": "$input.order_reference"
        },
        "output": {
          "order": "$result.order"
        }
      },
      {
        "id": "fetch_status",
        "tool": "shopify.get_delivery_status",
        "input": {
          "order": "$resolve_order.order"
        }
      }
    ],
    "output": {
      "delivery_status": "$fetch_status.status",
      "delivered_at": "$fetch_status.delivered_at"
    }
  }
}