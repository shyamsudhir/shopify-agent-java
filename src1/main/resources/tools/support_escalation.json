    {
      "name": "escalate_to_human",
      "category": "49. Support Escalation",
      "sub_intent": "escalation",
      "description": "Hand the conversation off to a human support agent.",
      "invoke_when": "Customer explicitly asks for a human, request is outside tool coverage, repeated failed attempts, or policy requires human review (e.g. large refund, legal threat).",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer_email": {
            "type": "string",
            "description": "customer_email"
          },
          "reason": {
            "type": "string",
            "description": "reason"
          },
          "conversation_summary": {
            "type": "string",
            "description": "conversation_summary"
          },
          "priority": {
            "type": "string",
            "description": "priority"
          },
          "department": {
            "type": "string",
            "description": "department"
          }
        },
        "required": [
          "customer_email",
          "reason",
          "conversation_summary"
        ]
      },
      "outputs": "Ticket ID / live handoff confirmation",
      "failure_scenarios": "No human agents available (after-hours) — falls back to ticket queue",
      "read_or_write": "write",
      "human_confirmation_required": false,
      "customer_visible_followup": "Confirms handoff and expected response time.",
      "related_tools": [
        "file_complaint",
        "flag_account_security"
      ],
      "exposure": "Wrapped",
      "shopify_api": {
        "source": "Third-party App API",
        "http_method": "POST",
        "operation": "Helpdesk ticket-creation endpoint (e.g. Zendesk POST /api/v2/tickets, Gorgias POST /api/tickets) or Shopify Inbox handoff",
        "api_version": "provider-specific",
        "endpoint": "helpdesk REST endpoint",
        "request_parameters": {
          "required": [
            {
              "name": "customer_email",
              "type": "string"
            },
            {
              "name": "reason",
              "type": "string"
            },
            {
              "name": "conversation_summary",
              "type": "string"
            }
          ],
          "optional": [
            {
              "name": "priority",
              "type": "string"
            },
            {
              "name": "department",
              "type": "string"
            }
          ]
        }
      }
    },
