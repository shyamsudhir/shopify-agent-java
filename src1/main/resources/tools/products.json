      "exposure": "Direct",
      "shopify_api": {
        "source": "Shopify Admin GraphQL API",
        "http_method": "POST",
        "operation": "query product(id) or productByHandle(handle)",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "id",
              "type": "ID (gid://shopify/Product/…)",
              "description": "Product GID — resolved from title via search_products if only a title is given"
