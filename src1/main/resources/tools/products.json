    {
      "name": "check_product_availability",
      "category": "4. Inventory",
      "sub_intent": "product_availability",
      "description": "Check stock for a specific variant.",
      "invoke_when": "Before recommending purchase, or customer asks 'is X in stock'.",
      "input_schema": {
        "type": "object",
        "properties": {
          "product_id_or_title": {
            "type": "string",
            "description": "product_id_or_title"
          },
          "variant_descriptor": {
            "type": "string",
            "description": "variant_descriptor"
          },
          "location_id": {
            "type": "string",
            "description": "location_id"
          }
        },
        "required": [
          "product_id_or_title",
          "variant_descriptor"
        ]
      },
      "outputs": "In-stock boolean, quantity band, ETA if backordered",
      "failure_scenarios": "Variant ambiguous (multiple matches)",
      "read_or_write": "read",
      "human_confirmation_required": false,
      "customer_visible_followup": "States stock status; offers alternative if OOS.",
      "related_tools": [
        "get_product",
        "notify_when_back_in_stock"
      ],
      "exposure": "Direct",
      "shopify_api": {
        "source": "Shopify Admin GraphQL API",
        "http_method": "POST",
        "operation": "query productVariant(id) { inventoryQuantity, inventoryItem { inventoryLevels(first) { available } } }",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "id",
              "type": "ID",
              "description": "ProductVariant GID (resolved from title + variant_descriptor)"
            }
          ],
          "optional": [
            {
              "name": "locationId",
              "type": "ID",
              "description": "Restrict to a specific inventory location"
            }
          ]
        }
      }
    },
