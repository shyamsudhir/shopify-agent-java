{
  "higher_intent": "products",
  "description": "Catalog discovery: search, browsing,  comparison, detail lookup, and availability, Show stock spread across warehouses/stores",
  "tool_count": 12,
  "tools": [
    {
      "name": "search_products",
      "category": "2. Products",
      "sub_intent": "product_search",
      "description": "Keyword/faceted product search.",
      "invoke_when": "Customer describes a product need or searches by name.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "query"
          },
          "max_price": {
            "type": "number",
            "description": "max_price"
          },
          "category": {
            "type": "string",
            "description": "category"
          },
          "tags": {
            "type": "string",
            "description": "tags"
          },
          "in_stock_only": {
            "type": "boolean",
            "description": "in_stock_only"
          },
          "sort": {
            "type": "string",
            "description": "sort"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputs": "List of product summaries",
      "failure_scenarios": "No matches; catalog API timeout",
      "read_or_write": "read",
      "human_confirmation_required": false,
      "customer_visible_followup": "Presents product options with images/prices.",
      "related_tools": [
        "get_product",
        "recommend_products",
        "check_product_availability"
      ],
      "exposure": "Direct",
      "shopify_api": {
        "source": "Shopify Admin GraphQL API",
        "http_method": "POST",
        "operation": "query products(first, query, sortKey)",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "query",
              "type": "string",
              "description": "Search filter string, e.g. \"title:*running shoes* AND status:active\""
            }
          ],
          "optional": [
            {
              "name": "first",
              "type": "int",
              "description": "Page size, default 10"
            },
            {
              "name": "sortKey",
              "type": "enum",
              "description": "RELEVANCE, PRICE, TITLE, etc."
            },
            {
              "name": "after",
              "type": "string",
              "description": "Pagination cursor"
            }
          ]
        }
      }
    },
    {
      "name": "global_search",
      "category": "5. Search (Cross-Entity)",
      "sub_intent": "product_search",
      "description": "Federated search across products, FAQs, policies, and blog content.",
