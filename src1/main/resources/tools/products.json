    {
      "name": "get_product",
      "category": "2. Products",
      "sub_intent": "product_details",
      "description": "Full product detail: price, variants, description, images, metafields.",
      "invoke_when": "Customer references a specific product by name/ID.",
      "input_schema": {
        "type": "object",
        "properties": {
          "product_id_or_title": {
            "type": "string",
            "description": "product_id_or_title"
          }
        },
        "required": [
          "product_id_or_title"
        ]
      },
      "outputs": "Full product object",
      "failure_scenarios": "Product not found/archived/draft-hidden",
