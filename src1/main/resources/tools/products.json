      "outputs": "Ranked mixed-type results",
      "failure_scenarios": "Search index stale",
      "read_or_write": "read",
      "human_confirmation_required": false,
      "customer_visible_followup": "Routes to best-fit answer type.",
      "related_tools": [
        "search_products",
        "search_faq",
        "search_policies"
      ],
      "exposure": "Direct",
      "shopify_api": {
        "source": "Internal Service",
        "http_method": "POST",
        "operation": "RAG/vector index query, optionally fanned out to product/content GraphQL calls",
        "api_version": "n/a",
        "endpoint": "internal search/RAG service; may call search_products, search_faq, get_store_policies internally",
        "request_parameters": {
          "required": [
            {
              "name": "query",
              "type": "string",
              "description": "Free-text query"
            }
          ],
          "optional": [
            {
              "name": "entity_types",
              "type": "[string]",
              "description": "Restrict to product, faq, policy, blog"
            }
          ]
        }
      }
    },
