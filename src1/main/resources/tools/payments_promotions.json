    {
      "name": "retry_payment",
      "category": "18. Payments",
      "sub_intent": "payment_status",
      "description": "Retry payment collection on an order with a failed transaction.",
      "invoke_when": "Order has a declined/failed payment and customer wants to complete it.",
      "input_schema": {
        "type": "object",
        "properties": {
          "order_number": {
            "type": "string",
            "description": "order_number"
          },
          "new_payment_method_token": {
            "type": "string",
            "description": "new_payment_method_token"
          }
        },
        "required": [
          "order_number"
        ]
      },
      "outputs": "Retry result (success/decline reason)",
      "failure_scenarios": "Card still declines; gateway timeout",
      "read_or_write": "write",
      "human_confirmation_required": false,
      "customer_visible_followup": "Confirms success or explains decline reason.",
      "related_tools": [
        "get_order",
        "update_payment_method"
      ],
      "exposure": "Wrapped",
      "shopify_api": {
        "source": "Shopify Admin GraphQL API",
        "http_method": "POST",
        "operation": "mutation orderCapture(input: OrderCaptureInput!) or paymentTermsUpdate — actual retry typically via Shopify Payments/PSP token",
        "api_version": "2025-01",
        "endpoint": "/admin/api/2025-01/graphql.json",
        "request_parameters": {
          "required": [
            {
              "name": "orderId",
              "type": "ID"
            }
          ],
          "optional": [
            {
              "name": "paymentMethodToken",
              "type": "string",
              "description": "New/updated tokenized payment method if the retry uses a different card"
            }
          ]
        }
      }
    },
